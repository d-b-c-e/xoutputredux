<Window x:Class="XOutputRedux.App.HidHideManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HidHide Manager"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Icon="pack://application:,,,/Assets/Icons/favicon.ico">
    <Grid Margin="12" TextElement.Foreground="#E0E0E0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Status bar: cloak state + driver + refresh -->
        <Border Grid.Row="0" Background="#2A2A2A" CornerRadius="4" Padding="10" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Cloaking: " VerticalAlignment="Center"/>
                <TextBlock x:Name="CloakStateText" Text="…" FontWeight="Bold" VerticalAlignment="Center" MinWidth="130"/>
                <Button x:Name="CloakToggleButton" Content="Toggle" Padding="10,3" Click="CloakToggle_Click"/>
                <TextBlock Text="   Driver: " VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock x:Name="DriverStateText" Text="…" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="Refresh" Padding="10,3" Margin="16,0,0,0" Click="Refresh_Click"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Margin="2,0,0,6" Foreground="#A0A0A0" TextWrapping="Wrap"
                   Text="Gaming devices HidHide can see. A 'HIDDEN' device is invisible to apps that aren't whitelisted (games, joy.cpl, the Stream Deck app). Select one and Hide / Unhide it. Changes need XOutputRedux running as administrator."/>

        <ListView Grid.Row="2" x:Name="DeviceList" Background="#252525" Foreground="#E0E0E0" BorderBrush="#3C3C3C">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Device" Width="300" DisplayMemberBinding="{Binding Product}"/>
                    <GridViewColumn Header="Present" Width="70" DisplayMemberBinding="{Binding PresentText}"/>
                    <GridViewColumn Header="Hidden" Width="70" DisplayMemberBinding="{Binding HiddenText}"/>
                    <GridViewColumn Header="Instance path" Width="290" DisplayMemberBinding="{Binding Path}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Hide selected" Padding="12,5" Click="HideSelected_Click"/>
            <Button Content="Unhide selected" Padding="12,5" Margin="8,0,0,0" Click="UnhideSelected_Click"/>
            <Button Content="Unhide ALL (reset)" Padding="12,5" Margin="8,0,0,0" Click="UnhideAll_Click"/>
        </StackPanel>

        <Expander Grid.Row="4" Header="Whitelisted applications (can see hidden devices)" Margin="0,10,0,0" Foreground="#C0C0C0">
            <ListBox x:Name="WhitelistBox" Height="90" Background="#252525" Foreground="#C0C0C0" BorderBrush="#3C3C3C" Margin="0,4,0,0"/>
        </Expander>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="#8AC0FF" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="Close" Padding="15,6" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
