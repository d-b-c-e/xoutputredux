<Window x:Class="XOutputRedux.App.IsolationProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Isolation Profile"
        Height="620" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        Icon="pack://application:,,,/Assets/Icons/favicon.ico">
    <Grid Margin="12" TextElement.Foreground="#E0E0E0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Profile: " VerticalAlignment="Center" FontSize="14"/>
            <TextBlock x:Name="NameText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <Border Background="#264F78" CornerRadius="3" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="ISOLATION" FontSize="11" FontWeight="Bold" Foreground="#9CDCFE"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" Margin="2,0,0,8" Foreground="#A0A0A0" TextWrapping="Wrap"
                   Text="Check the device(s) to KEEP VISIBLE while this profile is running. Every other HID gaming device is hidden via HidHide for the duration, then restored exactly when the profile stops. No virtual Xbox controller is created — the kept device stays fully native, so DirectInput force feedback keeps working. Use this for games that auto-detect the first wheel they find (e.g. keep the Moza wheel, hide vJoy / shifter / stalk)."/>

        <ListView Grid.Row="2" x:Name="DeviceList" Background="#252525" Foreground="#E0E0E0" BorderBrush="#3C3C3C">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Keep" Width="50">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Keep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Device" Width="290" DisplayMemberBinding="{Binding Product}"/>
                    <GridViewColumn Header="Present" Width="110" DisplayMemberBinding="{Binding PresentText}"/>
                    <GridViewColumn Header="Instance path" Width="310" DisplayMemberBinding="{Binding Path}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3" Margin="2,8,0,0" Foreground="#A0A0A0" TextWrapping="Wrap"
                   Text="Unchecked present devices will be hidden while the profile runs. Devices remembered by the profile but not currently connected stay in the keep list."/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Refresh Devices" Padding="12,5" Click="Refresh_Click"/>
                <TextBlock x:Name="StatusText" Foreground="#8AC0FF" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Padding="20,6" Click="Save_Click" IsDefault="True"
                        Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                <Button Content="Cancel" Padding="15,6" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
